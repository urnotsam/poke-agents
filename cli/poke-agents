#!/usr/bin/env python3
"""poke-agents — manage the desktop sprite overlay for Claude Code sessions.

    poke-agents install      wire the hooks into ~/.claude/settings.json
    poke-agents uninstall    remove them again
    poke-agents doctor       report what is and is not working
    poke-agents ls           list live session records
    poke-agents fetch        download and cache sprites
    poke-agents adopt        show sessions your terminal already knows about
    poke-agents terminals    list terminal adapters and what they support
    poke-agents prune        delete session records whose process is gone
    poke-agents simulate     write fake sessions so the overlay can be exercised
"""

import argparse
import concurrent.futures
import os
import random
import signal
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(
    os.path.abspath(__file__))), "hook"))

from pokeagents import (atomicio, events, harness, labels, opencode, paths,
                       process, settings, species, sprites, state, terminals)  # noqa: E402

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
HOOK_PATH = os.path.join(REPO_ROOT, "hook", "pokeagents_hook.py")
BUILTIN_TERMINALS = os.path.join(REPO_ROOT, "terminals")
OPENCODE_PLUGIN = os.path.join(REPO_ROOT, "harnesses", "opencode", "poke-agents.js")

FETCH_TIMEOUT = 20


# --------------------------------------------------------------------------- install

def cmd_install(args):
    wanted = args.harness
    installed_any = False

    if wanted in ("claude-code", "all"):
        path = args.settings or settings.default_path()
        try:
            settings.install(path, HOOK_PATH, python=args.python)
        except settings.SettingsError as exc:
            return _fail(str(exc))
        installed_any = True
        print("Claude Code")
        print("  settings: %s" % path)
        print("  events:   %s" % ", ".join(settings.EVENTS))
        print("  hook:     %s" % HOOK_PATH)

    if wanted in ("opencode", "all"):
        if wanted == "all" and not opencode.is_available():
            print("\nOpenCode: not installed, skipped")
        else:
            try:
                target = opencode.install(OPENCODE_PLUGIN, HOOK_PATH)
            except opencode.OpenCodeError as exc:
                return _fail(str(exc))
            installed_any = True
            print("\nOpenCode")
            print("  plugin:   %s" % target)
            print("  events:   %s" % ", ".join(sorted(harness.OPENCODE.event_map)))
            print("  restart OpenCode for it to load the plugin.")

    if not installed_any:
        return _fail("nothing to install for harness %r" % wanted)
    print("")

    installed, skipped = _install_terminals(force=args.force_terminals)
    if installed:
        print("  adapters installed: %s" % ", ".join(installed))
    if skipped:
        print("  adapters left alone (yours): %s" % ", ".join(skipped))

    detected = [a.name for a in terminals.detected(_preferred_terminals())]
    print("  detected terminals: %s" % (", ".join(detected) or "none"))
    if not detected:
        print("\n  No adapter recognised your terminal. Clicking a sprite will do")
        print("  nothing until you add one — see terminals/README.md, it is short.")

    print("\nExisting sessions won't have sprites until they fire their next event.")
    print("Run `poke-agents adopt --watch` to see them now.")
    return 0


def _install_terminals(force=False):
    """Copy the built-in adapters into place.

    Never overwrites an existing file: a user who edited an adapter, or wrote
    their own with a built-in's name, keeps it across upgrades.
    """
    import shutil

    target = terminals.directory()
    try:
        os.makedirs(target, exist_ok=True)
        names = sorted(os.listdir(BUILTIN_TERMINALS))
    except OSError:
        return [], []

    installed, skipped = [], []
    for name in names:
        source = os.path.join(BUILTIN_TERMINALS, name)
        if name.endswith(".md") or not os.path.isfile(source):
            continue
        destination = os.path.join(target, name)
        if os.path.exists(destination) and not force:
            skipped.append(name)
            continue
        try:
            shutil.copy2(source, destination)
            os.chmod(destination, 0o755)
            installed.append(name)
        except OSError:
            continue
    return installed, skipped


def cmd_uninstall(args):
    if args.harness in ("claude-code", "all"):
        path = args.settings or settings.default_path()
        try:
            settings.uninstall(path)
        except settings.SettingsError as exc:
            return _fail(str(exc))
        print("Removed hooks from %s" % path)

    if args.harness in ("opencode", "all"):
        if opencode.uninstall():
            print("Removed the OpenCode plugin")
        else:
            print("No OpenCode plugin of ours to remove")
    return 0


# --------------------------------------------------------------------------- doctor

def cmd_doctor(args):
    path = args.settings or settings.default_path()
    ok = True

    installed = settings.is_installed(path)
    ok &= _check("claude code hooks", installed, path)
    if opencode.is_available():
        _check("opencode plugin", opencode.is_installed(), opencode.plugin_path())
    else:
        print("  %-22s %s  %s" % ("opencode plugin", "n/a  ", "OpenCode not installed"))
    ok &= _check("hook script present", os.path.exists(HOOK_PATH), HOOK_PATH)

    sessions = state.read_all(paths.sessions_dir())
    live = [r for r in sessions if not state.is_stale(r)]
    _check("state directory", os.path.isdir(paths.sessions_dir()), paths.sessions_dir())
    print("  %-22s %d live, %d stale" % ("sessions", len(live), len(sessions) - len(live)))

    cached = _cached_species()
    print("  %-22s %d species cached in %s" % ("sprites", len(cached), paths.sprites_dir()))

    running = _overlay_running()
    _check("overlay running", running, "PokeAgents.app")
    print("  %-22s %s" % ("display mode", _display_mode()))

    if paths.disabled():
        print("\n  POKEAGENTS_DISABLE is set — the hook is short-circuiting.")
        ok = False

    if not installed:
        print("\nRun `poke-agents install` to wire up the hooks.")
    if not running:
        print("Launch PokeAgents.app to see sprites.")
    return 0 if ok else 1


def _check(label, ok, detail=""):
    print("  %-22s %s  %s" % (label, "ok  " if ok else "MISSING", detail))
    return bool(ok)


# Must match DisplayMode.default in PokeAgentsCore/DisplayMode.swift; the
# overlay only writes config.json once the mode is changed from the menu.
_DEFAULT_MODE = "clusterBottomRight"


def _display_mode():
    """Read the overlay's chosen arrangement, which it stores next to the state."""
    import json
    path = os.path.join(paths.home(), "config.json")
    try:
        with open(path) as fh:
            return json.load(fh).get("mode", _DEFAULT_MODE + " (default)")
    except (OSError, ValueError):
        return _DEFAULT_MODE + " (default)"


def _overlay_running():
    import subprocess
    try:
        out = subprocess.run(["pgrep", "-x", "PokeAgents"], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, timeout=5)
        return out.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


# --------------------------------------------------------------------------- ls

def cmd_ls(args):
    records = sorted(state.read_all(paths.sessions_dir()), key=lambda r: r.started_at)
    if not records:
        print("No sessions.")
        return 0

    print("%-26s %-12s %-14s %-11s %s" % ("LABEL", "STATE", "SPECIES", "TTY", "AGE"))
    now = int(time.time())
    for rec in records:
        stale = " (stale)" if state.is_stale(rec, now) else ""
        print("%-26s %-12s %-14s %-11s %s%s" % (
            rec.label[:26], rec.state, rec.species,
            (rec.tty or "-").replace("/dev/", ""),
            _age(now - rec.started_at), stale,
        ))
    return 0


def _age(seconds):
    seconds = max(0, int(seconds))
    if seconds < 60:
        return "%ds" % seconds
    if seconds < 3600:
        return "%dm%02ds" % (seconds // 60, seconds % 60)
    return "%dh%02dm" % (seconds // 3600, (seconds % 3600) // 60)


# --------------------------------------------------------------------------- fetch

def cmd_fetch(args):
    names = args.species or (species.SPECIES if args.all else [])
    if not names:
        return _fail("name a species, or pass --all")

    unknown = [n for n in names if n not in species.SPECIES]
    if unknown:
        return _fail("unknown species: %s" % ", ".join(unknown))

    os.makedirs(paths.sprites_dir(), exist_ok=True)
    jobs = [(name, variant) for name in names for variant in sprites.VARIANTS]
    todo = [j for j in jobs
            if args.force or not os.path.exists(_sprite_path(j[0], j[1]))]

    if not todo:
        print("All %d sprites already cached." % len(names))
        return 0

    print("Fetching %d files for %d species..." % (len(todo), len(names)))
    failures = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        for filename, error in pool.map(_fetch_one, todo):
            if error:
                failures.append((filename, error))

    print("Cached %d files in %s" % (len(todo) - len(failures), paths.sprites_dir()))
    for target, error in failures:
        print("  failed: %s (%s)" % (target, error), file=sys.stderr)
    return 1 if failures else 0


def _sprite_path(name, variant):
    return os.path.join(paths.sprites_dir(), variant.filename(name))


def _fetch_one(job):
    name, variant = job
    dest = _sprite_path(name, variant)
    try:
        req = urllib.request.Request(variant.url(name),
                                     headers={"User-Agent": sprites.USER_AGENT})
        with urllib.request.urlopen(req, timeout=FETCH_TIMEOUT) as response:
            # urllib follows redirects, including off-host ones. Only bytes from
            # the expected host get written to the cache.
            host = urllib.parse.urlparse(response.geturl()).hostname
            if host != sprites.HOST:
                return variant.filename(name), "redirected to %s" % host
            # Read one byte past the cap so an oversized body is detected
            # rather than silently truncated.
            body = response.read(sprites.MAX_BYTES + 1)

        if len(body) > sprites.MAX_BYTES:
            return variant.filename(name), "larger than %d bytes" % sprites.MAX_BYTES
        if not sprites.looks_like(variant.extension, body):
            return variant.filename(name), "not a %s" % variant.extension

        atomicio.write_bytes(dest, body)
        return variant.filename(name), None
    except (urllib.error.URLError, OSError) as exc:
        return variant.filename(name), exc


def _cached_species():
    try:
        files = os.listdir(paths.sprites_dir())
    except OSError:
        return set()
    return {f.split(".")[0].replace("-shiny", "").replace("-static", "")
            for f in files if f.endswith((".gif", ".png"))}


# --------------------------------------------------------------------------- adopt

def cmd_adopt(args):
    """Publish sprites for sessions the terminal already knows about.

    The hook only learns about a session when that session next fires an event,
    so a fresh install shows nothing until you type something. Any adapter that
    implements `discover` can enumerate its sessions instead, which means real
    sessions appear immediately and without touching any settings file.
    """
    adapters = terminals.discovering(_preferred_terminals())
    if not adapters:
        return _fail("no terminal adapter supports discovery; "
                     "see terminals/README.md to add one for your terminal")

    print("Discovering via: %s" % ", ".join(a.name for a in adapters))

    if not args.watch:
        print("Adopted %d session(s)." % len(_adopt_once(adapters)))
        return 0

    print("Refreshing every %.1fs. Ctrl-C to stop." % args.interval)
    stop = _install_stop_flag()
    adopted = set()
    try:
        while not stop["now"]:
            adopted |= set(_adopt_once(adapters))
            for _ in range(int(max(1, args.interval / 0.2))):
                if stop["now"]:
                    break
                time.sleep(0.2)
    finally:
        if args.cleanup:
            for sid in adopted:
                state.delete(paths.sessions_dir(), sid)
            print("\nRemoved %d adopted session(s)." % len(adopted))
        else:
            print("\nLeaving %d adopted session(s) in place." % len(adopted))
    return 0


def _adopt_once(adapters):
    directory = paths.sessions_dir()
    now = int(time.time())

    # Anything the adapters no longer report, or whose process died, goes away.
    state.prune(directory, now)

    existing_records = state.read_all(directory)
    taken = {r.species for r in existing_records}

    # Once the hooks are installed a session writes its own record, keyed by
    # Claude's session id. Adopting the same process under a different id would
    # put two sprites on screen for one session, so hook-written records win.
    hooked_pids = {r.pid for r in existing_records
                   if r.pid and not r.session_id.startswith("adopted-")}

    ids = []
    for adapter in adapters:
        for found in adapter.discover():
            pid = found.get("pid")
            if not isinstance(pid, int) or pid <= 0:
                continue

            if pid in hooked_pids:
                # Already represented by its own hook-written record.
                state.delete(directory, "adopted-%s-%d" % (adapter.name, pid))
                continue

            session_id = "adopted-%s-%d" % (adapter.name, pid)
            ids.append(session_id)

            existing = state.read(directory, session_id)
            if existing is None:
                pick = species.assign(session_id, taken=taken)
                started, name, shiny = now, pick.name, pick.shiny
            else:
                started, name, shiny = (existing.started_at, existing.species,
                                        existing.shiny)
            taken.add(name)

            found_state = found.get("state")
            state.write(directory, state.SessionRecord(
                session_id=session_id,
                label=_adopt_label(found),
                cwd=found.get("cwd") or "",
                species=name,
                shiny=shiny,
                state=found_state if found_state in events.STATES else events.RUNNING,
                pid=pid,
                tty=found.get("tty"),
                terminal=adapter.name,
                started_at=started,
                updated_at=now,
                last_tool=None,
            ))
    return ids


def _adopt_label(found):
    """Prefer what the session is doing over where it lives."""
    title = (found.get("label") or "").strip()
    if title:
        return labels.format_label(display_name=title, repo=None, branch=None,
                                   is_worktree=False, cwd_basename="")
    return labels.derive(found.get("cwd") or "")


# --------------------------------------------------------------------------- terminals

def cmd_terminals(args):
    adapters = terminals.available(_preferred_terminals())
    if not adapters:
        return _fail("no adapters in %s; run `poke-agents install`"
                     % terminals.directory())

    print("%-16s %-10s %-10s %s" % ("ADAPTER", "DETECTED", "DISCOVERS", "PATH"))
    for adapter in adapters:
        print("%-16s %-10s %-10s %s" % (
            adapter.name,
            "yes" if adapter.detects() else "no",
            "yes" if adapter.can_discover() else "no",
            adapter.path,
        ))

    if args.focus:
        print()
        record = _record_for_pid(args.focus)
        if record is None:
            print("No session recorded for pid %d; trying pid/tty directly."
                  % args.focus)
        for adapter in adapters:
            if not adapter.detects():
                continue
            ok = adapter.focus(args.focus, record.tty if record else None)
            print("  %-16s focus -> %s" % (adapter.name, "ok" if ok else "declined"))
            if ok:
                break
    return 0


def _record_for_pid(pid):
    for record in state.read_all(paths.sessions_dir()):
        if record.pid == pid:
            return record
    return None


def _preferred_terminals():
    import json
    path = os.path.join(paths.home(), "config.json")
    try:
        with open(path) as fh:
            names = json.load(fh).get("terminals", [])
    except (OSError, ValueError):
        return []
    return [n for n in names if isinstance(n, str)]


# --------------------------------------------------------------------------- prune

def cmd_prune(args):
    removed = state.prune(paths.sessions_dir())
    print("Removed %d stale session(s)." % len(removed))
    for sid in removed:
        print("  %s" % sid)
    return 0


# --------------------------------------------------------------------------- simulate

def cmd_simulate(args):
    """Write fake session records so the overlay can be exercised without agents.

    Records carry this process's pid, so the overlay's reaper treats them as live
    and despawns them the moment this command exits.
    """
    directory = paths.sessions_dir()
    rng = random.Random(args.seed)
    states = args.states or list(events.STATES)

    # Borrow real terminal identities so click-to-focus is exercisable against
    # real panes. Cycling through every live session rather than reusing one
    # means clicking different sprites focuses different places, which is the
    # only way this actually tests anything.
    tty = _current_tty() if args.attach else None
    pids = _focusable_pids() if args.attach else []
    if args.attach:
        if pids:
            print("Attaching to %d live session(s): %s"
                  % (len(pids), ", ".join(str(p) for p in pids)))
        else:
            print("warning: no focusable sessions found; clicks will have no target",
                  file=sys.stderr)

    created = []
    now = int(time.time())
    for index in range(args.count):
        session_id = "simulated-%02d" % index
        taken = {r.species for r in state.read_all(directory)}
        pick = species.assign(session_id, taken=taken)
        record = state.SessionRecord(
            session_id=session_id,
            label=rng.choice(_FAKE_LABELS),
            cwd=os.getcwd(),
            species=pick.name,
            shiny=pick.shiny,
            state=states[index % len(states)],
            pid=pids[index % len(pids)] if pids else os.getpid(),
            tty=tty,
            terminal="Apple_Terminal" if tty else "simulated",
            started_at=now - rng.randint(10, 3600),
            updated_at=now,
            last_tool=rng.choice(["Bash", "Edit", "Read", "WebSearch", None]),
        )
        state.write(directory, record)
        created.append(session_id)

    print("Simulated %d sessions in %s" % (len(created), directory))
    for sid in created:
        rec = state.read(directory, sid)
        print("  %-14s %-11s %s" % (rec.label[:14], rec.state, rec.species))

    if args.cycle:
        print("\nCycling states every %ss. Ctrl-C to stop and clean up." % args.cycle)
    else:
        print("\nHolding. Ctrl-C to stop and clean up.")

    _hold(directory, created, args.cycle, rng)
    return 0


def _current_tty():
    """The controlling terminal of this invocation.

    A shell run from a pipeline has no tty of its own, so this walks up the
    process tree the same way the hook does and takes the first real one it
    finds. Returns None when nothing in the chain owns a terminal, which is the
    case for a background agent.
    """
    pid = os.getpid()
    for _ in range(process.MAX_DEPTH):
        info = process.lookup_proc(pid)
        if info is None:
            return None
        normalized = process.normalize_tty(info.tty)
        if normalized:
            return normalized
        if info.ppid <= 1:
            return None
        pid = info.ppid
    return None


def _focusable_pids():
    """Claude pids something can actually focus.

    Cycling simulated sprites across several real sessions is the only way this
    tests anything: pointing them all at one pid makes every sprite focus the
    same place no matter whether the code is right.
    """
    pids = []
    for adapter in terminals.discovering(_preferred_terminals()):
        for found in adapter.discover():
            pid = found.get("pid")
            if isinstance(pid, int) and pid > 0 and pid not in pids:
                pids.append(pid)

    if not pids:
        info = process.find_claude(os.getpid())
        if info:
            pids.append(info.pid)
    return pids


def _herdr_json(args):
    import json
    import subprocess

    path = _herdr_path()
    if not path:
        return None
    try:
        out = subprocess.run([path] + args, stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    try:
        return json.loads(out.stdout.decode()).get("result")
    except (ValueError, UnicodeDecodeError):
        return None


_FAKE_LABELS = [
    "widgets-api", "widgets@hotfix", "billing-worker", "internal-tools",
    "data-pipeline", "weekly-report", "search-index", "mobile-app",
    "auth-service", "docs-site", "pokeagents", "widgets@refactor",
]


def _hold(directory, session_ids, cycle, rng):
    stop = _install_stop_flag()
    last = time.time()
    try:
        while not stop["now"]:
            time.sleep(0.2)
            if cycle and (time.time() - last) >= cycle:
                last = time.time()
                sid = rng.choice(session_ids)
                record = state.read(directory, sid)
                if record:
                    record.state = rng.choice(list(events.STATES))
                    record.updated_at = int(time.time())
                    state.write(directory, record)
                    print("  %s -> %s" % (record.label, record.state))
    finally:
        for sid in session_ids:
            state.delete(directory, sid)
        print("\nCleaned up %d simulated sessions." % len(session_ids))


# --------------------------------------------------------------------------- main

def _install_stop_flag():
    """Wire SIGINT/SIGTERM to a flag the long-running loops poll.

    Shared so a change to shutdown behaviour applies to every loop instead of
    only the one that was remembered.
    """
    stop = {"now": False}

    def _stop(_signum, _frame):
        stop["now"] = True

    signal.signal(signal.SIGINT, _stop)
    signal.signal(signal.SIGTERM, _stop)
    return stop


def _fail(message):
    print("error: %s" % message, file=sys.stderr)
    return 1


def build_parser():
    parser = argparse.ArgumentParser(prog="poke-agents", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("install", help="wire hooks into settings.json")
    p.add_argument("--settings", help="settings file (default ~/.claude/settings.json)")
    p.add_argument("--python", help="python interpreter for the hook command")
    p.add_argument("--force-terminals", action="store_true",
                   help="overwrite terminal adapters with the bundled versions")
    p.add_argument("--harness", default="claude-code",
                   choices=list(harness.names()) + ["all"],
                   help="which agent harness to wire up (default: claude-code)")
    p.set_defaults(func=cmd_install)

    p = sub.add_parser("uninstall", help="remove PokeAgents's hook entries")
    p.add_argument("--settings")
    p.set_defaults(func=cmd_uninstall)

    p = sub.add_parser("doctor", help="report configuration health")
    p.add_argument("--settings")
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser("ls", help="list session records")
    p.set_defaults(func=cmd_ls)

    p = sub.add_parser("fetch", help="download sprites into the cache")
    p.add_argument("species", nargs="*")
    p.add_argument("--all", action="store_true", help="fetch the entire roster")
    p.add_argument("--force", action="store_true", help="re-download cached sprites")
    p.set_defaults(func=cmd_fetch)

    p = sub.add_parser("adopt", help="show sessions your terminal already knows about")
    p.add_argument("--watch", action="store_true",
                   help="keep refreshing so sprite states stay current")
    p.add_argument("--interval", type=float, default=2.0)
    p.add_argument("--cleanup", action="store_true",
                   help="remove adopted sessions when watching stops")
    p.set_defaults(func=cmd_adopt)

    p = sub.add_parser("terminals", help="list terminal adapters and what they support")
    p.add_argument("--focus", type=int, metavar="PID",
                   help="attempt a real focus for this pid and report the result")
    p.set_defaults(func=cmd_terminals)

    p = sub.add_parser("prune", help="delete session records whose process is gone")
    p.set_defaults(func=cmd_prune)

    p = sub.add_parser("simulate", help="write fake sessions for testing")
    p.add_argument("--count", type=int, default=6)
    p.add_argument("--states", nargs="*", choices=list(events.STATES))
    p.add_argument("--cycle", type=float, default=0,
                   help="seconds between random state changes (0 = hold still)")
    p.add_argument("--seed", type=int, default=7)
    p.add_argument("--attach", action="store_true",
                   help="point simulated sessions at this terminal so clicks focus it")
    p.set_defaults(func=cmd_simulate)

    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
